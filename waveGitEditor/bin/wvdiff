#!/usr/bin/env python3
"""wvdiff — local HTTP server backing the wv Gerrit-CR web view.

Serves a dark Gerrit-like review page (working tree, log, per-commit patches)
for one git repo, plus JSON/diff APIs consumed by that page. Python 3 stdlib
only; binds 127.0.0.1; one server per repo; exits after idle timeout.

Usage: wvdiff --repo <abs-path> [--port N]   (port 0 = ephemeral)

State: ~/.local/state/wv/<md5-of-repo-path>.port  (port line)
       ~/.local/state/wv/wvdiff.log               (append)
"""

import hashlib
import json
import os
import re
import signal
import subprocess
import shutil
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import unquote, urlparse

EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
STATE_DIR = os.path.expanduser("~/.local/state/wv")
ASSETS_DIR = os.path.expanduser("~/.local/share/wvdiff/assets")
IDLE_SECS = int(os.environ.get("WVDIFF_IDLE_SECS", "7200"))

REPO = None
PORT_FILE = None
LOG_FILE = os.path.join(STATE_DIR, "wvdiff.log")
LAST_REQUEST = time.time()
CODE_MTIME = os.path.getmtime(os.path.abspath(__file__))


def log(msg):
    try:
        with open(LOG_FILE, "a") as f:
            f.write("%s wvdiff[%d] %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), os.getpid(), msg))
    except OSError:
        pass


def git(*args, binary=False):
    """Run git -C REPO, return stdout. Raises RuntimeError on failure."""
    cmd = ["git", "-C", REPO] + list(args)
    r = subprocess.run(cmd, capture_output=True)
    if r.returncode != 0:
        raise RuntimeError("git %s failed: %s" % (" ".join(args[:3]), r.stderr.decode("utf-8", "replace").strip()))
    return r.stdout if binary else r.stdout.decode("utf-8", "replace")


def head_or_empty_tree():
    try:
        return git("rev-parse", "--verify", "HEAD").strip()
    except RuntimeError:
        return EMPTY_TREE

def parse_numstat_z(out):
    """Parse `git diff --numstat -z` output → {newpath: (add, del, oldpath)}.

    Rename rows: `add\\tdel\\t<NUL>old<NUL>new<NUL>` → keyed by new path.
    Binary rows report '-' for both counts.
    """
    fields = out.split("\0")
    files = {}
    i = 0
    while i < len(fields):
        f = fields[i]
        if not f:
            i += 1
            continue
        parts = f.split("\t")
        if len(parts) < 3:
            i += 1
            continue
        add, dele, path = parts[0], parts[1], parts[2]
        if path == "":  # rename: next two fields are old, new
            if i + 2 < len(fields):
                files[fields[i + 2]] = (add, dele, fields[i + 1])
            i += 3
            continue
        files[path] = (add, dele, None)
        i += 1
    return files


def parse_name_status_z(out):
    """Parse `git diff --name-status -z -M` output → {newpath: (letter, oldpath)}.

    -z field layout: `D\\0<path>\\0`, `M\\0<path>\\0`, `R056\\0<old>\\0<new>\\0`.
    """
    fields = [f for f in out.split("\0") if f != ""]
    files = {}
    i = 0
    while i < len(fields):
        f = fields[i]
        if f and f[0].isupper() and (len(f) == 1 or f[1:].isdigit()):
            letter = f[0]
            if letter in ("R", "C") and i + 2 < len(fields):
                files[fields[i + 2]] = (letter, fields[i + 1])
                i += 3
            else:
                if i + 1 < len(fields):
                    files[fields[i + 1]] = (letter, None)
                i += 2
        else:
            i += 1
    return files




def parse_porcelain_z(out):
    """Parse `git status --porcelain=v1 -z -uall` → list of entries.

    Each: (xy, path, rename_from or None). In -z mode rename paths come as
    `R  <new>\\0<old>\\0` — new path first, old path as the next field.
    """
    entries = []
    fields = out.split("\0")
    i = 0
    while i < len(fields):
        f = fields[i]
        if not f:
            i += 1
            continue
        xy, path = f[:2], f[3:]
        if xy and xy[0] in ("R", "C") and i + 1 < len(fields):
            entries.append((xy, path, fields[i + 1]))  # path=new, next=old
            i += 2
        else:
            entries.append((xy, path, None))
            i += 1
    return entries


def status_letter(xy, untracked):
    if untracked:
        return "A"
    x, y = xy[0], xy[1] if len(xy) > 1 else " "
    if "R" in (x, y):
        return "R"
    if "D" in (x, y):
        return "D"
    if "A" in (x, y):
        return "A"
    return "M"


def untracked_stats(path):
    """(add_lines, binary) for an untracked file."""
    full = os.path.join(REPO, path)
    try:
        with open(full, "rb") as f:
            head = f.read(8192)
            binary = b"\0" in head
            add = head.count(b"\n")
            if not binary:
                rest = b""
                while True:
                    chunk = f.read(1 << 16)
                    if not chunk:
                        break
                    rest += chunk
                add += rest.count(b"\n")
    except OSError:
        return 0, True
    return add, binary


def worktree_rev():
    """Porcelain-only change rev: one git call; detects staged/unstaged/
    untracked/rename changes (numstat adds nothing to change detection)."""
    porcelain = git("status", "--porcelain=v1", "-z", "--untracked-files=all", binary=True)
    return hashlib.sha1(porcelain).hexdigest(), porcelain

def worktree_files():
    """File rows + totals + rev for the working tree view."""
    rev, porcelain = worktree_rev()
    base = head_or_empty_tree()
    head_arg = "HEAD" if base != EMPTY_TREE else EMPTY_TREE
    numstat = git("diff", head_arg, "--numstat", "-z", "--find-renames=40%", binary=True)

    ns = parse_numstat_z(numstat.decode("utf-8", "replace"))
    files = []
    for xy, path, old in parse_porcelain_z(porcelain.decode("utf-8", "replace")):
        untracked = xy == "??"
        if untracked:
            add, binary = untracked_stats(path)
            files.append({"path": path, "oldPath": None, "status": "A",
                          "add": add, "del": 0, "untracked": True, "binary": binary,
                          "xy": xy, "sig": "A:%d:0" % add})
            continue
        # tracked/rename row: stats from numstat (keyed by new path)
        st = ns.get(path, ("0", "0", None))
        add = st[0] if st[0] != "-" else 0
        dele = st[1] if st[1] != "-" else 0
        binary = st[0] == "-"
        oldp = old if old else st[2]
        files.append({"path": path, "oldPath": oldp,
                      "status": status_letter(xy, False),
                      "add": int(add), "del": int(dele),
                      "untracked": False, "binary": binary,
                      "xy": xy,
                      "sig": "%s:%d:%d" % (status_letter(xy, False), int(add), int(dele))})
    files.sort(key=lambda f: f["path"])
    totals = {"add": sum(f["add"] for f in files), "del": sum(f["del"] for f in files)}
    branch = git("rev-parse", "--abbrev-ref", "HEAD").strip()
    return {"rev": rev, "branch": branch, "totals": totals, "files": files, "repoPath": REPO}

def resolve_commit(sha):
    """Return full sha for a short/full sha; RuntimeError if not a commit."""
    full = git("rev-parse", "--verify", "--quiet", sha + "^{commit}").strip()
    if not full:
        raise RuntimeError("not a commit: %s" % sha)
    return full


def commit_files(base, sha):
    """File rows + totals for a commit diff (base → sha)."""
    nstat = parse_numstat_z(git("diff", "--numstat", "-M", "-z", base, sha))
    nstatus = parse_name_status_z(git("diff", "--name-status", "-M", "-z", base, sha))
    files = []
    for path, (letter, old) in nstatus.items():
        st = nstat.get(path, ("0", "0", None))
        binary = st[0] == "-"
        files.append({"path": path, "oldPath": old, "status": letter,
                      "add": 0 if binary else int(st[0]), "del": 0 if binary else int(st[1]),
                      "untracked": False, "binary": binary})
    files.sort(key=lambda f: f["path"])
    totals = {"add": sum(f["add"] for f in files), "del": sum(f["del"] for f in files)}
    return files, totals


def commit_data(sha):
    full = resolve_commit(sha)
    meta = git("show", "-s", "--format=%H%n%an <%ae>%n%aI%n%P%n%s%n%b", full)
    lines = meta.split("\n")
    sha_f, author, date, parents_line = lines[0], lines[1], lines[2], lines[3]
    subject = lines[4] if len(lines) > 4 else ""
    body = "\n".join(lines[5:]).strip()
    parents = [p[:7] for p in parents_line.split()] if parents_line.strip() else []
    try:
        base = git("rev-parse", "--verify", "--quiet", full + "^").strip() or EMPTY_TREE
    except RuntimeError:
        base = EMPTY_TREE
    files, totals = commit_files(base, full)
    return {"sha": sha_f, "short": sha_f[:7], "author": author, "date": date,
            "parents": parents, "subject": subject, "body": body,
            "totals": totals, "files": files}


def diff_worktree(paths, w=False):
    """Unified diff text for given worktree paths (tracked + untracked mix)."""
    wf = worktree_files()
    known = {}
    for f in wf["files"]:
        known[f["path"]] = f
        if f["oldPath"]:
            known[f["oldPath"]] = f
    tracked, untracked = [], []
    for p in paths:
        f = known.get(p)
        if f is None:
            raise ValueError("path not in worktree file list: %s" % p)
        if f["binary"]:
            continue
        if f["untracked"]:
            if p == f["path"]:
                untracked.append(p)
        else:
            tracked.append(p)
    out = []
    if tracked:
        head_arg = "HEAD" if head_or_empty_tree() != EMPTY_TREE else EMPTY_TREE
        args = ["diff", head_arg, "-M"]
        if w:
            args.append("-w")
        out.append(git(*(args + ["--"] + tracked)))
    for p in untracked:
        cmd = ["git", "-C", REPO, "diff", "--no-index"]
        if w:
            cmd.append("-w")
        cmd += ["--", "/dev/null", p]
        r = subprocess.run(cmd, capture_output=True)
        if r.returncode in (0, 1):
            out.append(r.stdout.decode("utf-8", "replace"))
    return "".join(out)


def diff_commit(sha, paths, w=False):
    full = resolve_commit(sha)
    try:
        base = git("rev-parse", "--verify", "--quiet", full + "^").strip() or EMPTY_TREE
    except RuntimeError:
        base = EMPTY_TREE
    nstatus = parse_name_status_z(git("diff", "--name-status", "-M", "-z", base, full))
    nstat = parse_numstat_z(git("diff", "--numstat", "-M", "-z", base, full))
    known = set(nstatus) | set(nstat)
    for old in [v[1] for v in nstatus.values() if v[1]]:
        known.add(old)
    safe = []
    for p in paths:
        if p not in known:
            raise ValueError("path not in commit file list: %s" % p)
        if p in nstat and nstat[p][0] == "-":
            continue  # binary
        safe.append(p)
    if not safe:
        return ""
    args = ["diff", "-M"]
    if w:
        args.append("-w")
    return git(*(args + [base, full, "--"] + safe))


def act(path, op):
    """Stage/unstage/discard a single worktree file (#3)."""
    wf = worktree_files()
    known = {}
    for f in wf["files"]:
        known[f["path"]] = f
        if f["oldPath"]:
            known[f["oldPath"]] = f
    f = known.get(path)
    if f is None:
        raise ValueError("path not in worktree file list: %s" % path)
    if op == "stage":
        git("add", "--", f["path"])
    elif op == "unstage":
        git("reset", "-q", "HEAD", "--", f["path"])
    elif op == "discard":
        if f["untracked"]:
            os.remove(os.path.join(REPO, f["path"]))
        else:
            base = "HEAD" if head_or_empty_tree() != EMPTY_TREE else EMPTY_TREE
            if base == EMPTY_TREE:
                raise RuntimeError("cannot discard without HEAD")
            def in_head(p):
                r = subprocess.run(["git", "-C", REPO, "cat-file", "-e", "HEAD:" + p],
                                   capture_output=True)
                return r.returncode == 0
            # restore paths HEAD knows; drop newly-added / rename-target paths
            restore = [p for p in (f["oldPath"], f["path"]) if p and in_head(p)]
            drop = [p for p in (f["oldPath"], f["path"]) if p and not in_head(p)]
            if restore:
                git("checkout", base, "--", *restore)
            for p in drop:
                r = subprocess.run(["git", "-C", REPO, "rm", "-q", "-f", "--", p],
                                   capture_output=True)
                if r.returncode != 0:
                    # not in index: remove any lingering worktree copy
                    subprocess.run(["git", "-C", REPO, "clean", "-qf", "--", p],
                                   capture_output=True)
    else:
        raise ValueError("bad op: %s" % op)
    return {"ok": True}


def commit_staged(message):
    """Commit the staged index (#13). Gerrit habit: staged changes only."""
    msg = (message or "").strip()
    if not msg:
        raise ValueError("empty commit message")
    if len(msg) > 4000:
        raise ValueError("commit message too long")
    staged = git("diff", "--cached", "--name-only").strip()
    if not staged:
        raise ValueError("nothing staged")
    git("commit", "-m", msg)
    return {"sha": git("rev-parse", "HEAD").strip()}


def upstream_ref():
    for spec in ("@{upstream}", "origin/master", "origin/main"):
        try:
            if git("rev-parse", "--verify", "--quiet", spec).strip():
                return spec
        except RuntimeError:
            continue
    return None


def vsup_data():
    up = upstream_ref()
    if up is None:
        return {"upstream": None, "ahead": 0, "files": [], "totals": {"add": 0, "del": 0}}
    try:
        ahead = int(git("rev-list", "--count", up + "..HEAD").strip() or 0)
    except RuntimeError:
        ahead = 0
    files, totals = commit_files(up, "HEAD")
    return {"upstream": up, "ahead": ahead, "files": files, "totals": totals}


def diff_vsup(paths, w=False):
    up = upstream_ref()
    if up is None:
        raise RuntimeError("no upstream branch")
    nstatus = parse_name_status_z(git("diff", "--name-status", "-M", "-z", up, "HEAD"))
    nstat = parse_numstat_z(git("diff", "--numstat", "-M", "-z", up, "HEAD"))
    known = set(nstatus) | set(nstat)
    for old in [v[1] for v in nstatus.values() if v[1]]:
        known.add(old)
    safe = []
    for p in paths:
        if p not in known:
            raise ValueError("path not in vs-upstream file list: %s" % p)
        if p in nstat and nstat[p][0] == "-":
            continue  # binary
        safe.append(p)
    if not safe:
        return ""
    args = ["diff", "-M"]
    if w:
        args.append("-w")
    return git(*(args + [up, "HEAD", "--"] + safe))


def notify_badge(clear):
    """Set/clear the Wave badge on the cockpit web block (#15). Best-effort."""
    if not os.environ.get("WAVETERM_JWT"):
        return {"ok": False, "reason": "no jwt"}
    key = hashlib.md5(REPO.encode()).hexdigest()
    bf = os.path.join(STATE_DIR, key + ".webblock")
    try:
        with open(bf) as f:
            bid = f.readline().strip()
    except OSError:
        return {"ok": False, "reason": "no webblock"}
    wsh = shutil.which("wsh") or os.path.expanduser("~/.waveterm/bin/wsh")
    cmd = [wsh, "badge", "circle-exclamation", "--color", "orange", "-b", bid]
    if clear:
        cmd.append("--clear")
    try:
        subprocess.run(cmd, capture_output=True, timeout=3)
        return {"ok": True}
    except Exception:  # noqa: BLE001
        return {"ok": False, "reason": "wsh failed"}


