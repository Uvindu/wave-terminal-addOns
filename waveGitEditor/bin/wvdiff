.logcount{color:var(--muted);font:12px ui-monospace,Menlo,Consolas,monospace}
.viewtoggle.active{color:var(--text);border-color:var(--orange)}
.actbtn{background:none;border:1px solid var(--border);color:var(--muted);
font:11px ui-monospace,Menlo,Consolas,monospace;padding:2px 6px;border-radius:3px;
cursor:pointer;margin-left:4px}
.actbtn:hover{color:var(--text);border-color:var(--muted)}
.actbtn.danger:hover{color:var(--red);border-color:var(--red)}
td.actcell{width:110px;text-align:right;white-space:nowrap}
.commitbox textarea{width:100%;background:var(--bg);border:1px solid var(--border);
color:var(--text);font:13px ui-monospace,Menlo,Consolas,monospace;padding:6px 8px;
border-radius:4px;resize:vertical;box-sizing:border-box}
.commitrow{display:flex;gap:8px;align-items:center;margin-top:8px}
.commitrow .errtxt{color:var(--red);font:12px ui-monospace,Menlo,Consolas,monospace}
.kbdhelp{position:fixed;bottom:8px;right:8px;z-index:9999;background:#000;color:#fff;
font:12px ui-monospace,Menlo,Consolas,monospace;padding:10px 12px;border:1px solid var(--border);
border-radius:6px;white-space:pre;display:none}
#selftest-out{position:fixed;bottom:0;left:0;z-index:99999;background:#000;color:#fff;
font:12px monospace;white-space:pre-wrap;max-width:100vw;max-height:60vh;overflow:auto;
margin:0;padding:8px}
</style></head>
<body>
<header>
 <div class="crumb"><span id="repoName"></span><span class="branch" id="branch"></span>
 <span class="totals" id="hdrTotals"></span><span class="totals" id="reviewedInfo"></span></div>
 <nav id="tabs"></nav>
 <button id="rvwFilter" class="viewtoggle" title="Show unreviewed files only">unreviewed only</button>
 <button id="wsToggle" class="viewtoggle" title="Ignore whitespace in diffs">w</button>
 <button id="viewToggle" class="viewtoggle" title="Toggle side-by-side / unified">&#8801;|</button>
</header>
<main id="main"><div class="empty">loading…</div></main>
<script src="/assets/diff2html-ui.min.js"></script>
<script>
"use strict";
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const D2H_CFG={drawFileList:false,outputFormat:"side-by-side",matching:"none",
 synchronisedScroll:true,highlight:true,fileListToggle:false,fileContentToggle:false,
 stickyFileHeaders:false,colorScheme:"dark"};
let pollTimer=null, lastRev=null;

const VIEW_KEY="wvdiff-view";
function loadViewPref(){try{return localStorage.getItem(VIEW_KEY)||"side-by-side";}catch(e){return "side-by-side";}}
function saveViewPref(v){try{localStorage.setItem(VIEW_KEY,v);}catch(e){/* private mode */}}
D2H_CFG.outputFormat=loadViewPref();

function setupViewToggle(){
  const btn=$("#viewToggle");
  const label=()=>D2H_CFG.outputFormat==="side-by-side"?"\u2261|":"\u2261";
  btn.textContent=label();
  btn.addEventListener("click",()=>{
    D2H_CFG.outputFormat=D2H_CFG.outputFormat==="side-by-side"?"line-by-line":"side-by-side";
    saveViewPref(D2H_CFG.outputFormat);
    btn.textContent=label();
    // re-draw any open diff box in the new format
    document.querySelectorAll("tr.diffrow").forEach(r=>{
      const box=r.querySelector(".diffbox");
      if(box&&box.dataset.diffText){renderDiffBox(box,box.dataset.diffText);}
    });
  });
}

// --- whitespace toggle (#8): persisted, sent with every diff POST; toggling
// re-fetches open diffs under the new flag.
const WS_KEY="wvdiff-ws";
function wsOn(){try{return localStorage.getItem(WS_KEY)==="1";}catch(e){return false;}}
function saveWs(v){try{v?localStorage.setItem(WS_KEY,"1"):localStorage.removeItem(WS_KEY);}catch(e){/* private mode */}}
function setupWsToggle(){
  const btn=$("#wsToggle");
  const label=()=>wsOn()?"w!":"w";
  btn.textContent=label();
  btn.classList.toggle("active",wsOn());
  btn.addEventListener("click",async()=>{
    saveWs(!wsOn());
    btn.textContent=label();
    btn.classList.toggle("active",wsOn());
    await refreshOpenDiffs();
  });
}
async function refreshOpenDiffs(){
  const st=captureState();
  document.querySelectorAll("tr.diffrow").forEach(r=>r.remove());
  await restoreState(st);
}

// --- state preservation (#1): capture expanded paths + scroll, restore after re-render
let tableRoot=null, filesByPath={}, postDiffCurrent=null, repoPath="";
function captureState(){
  const st={paths:[],y:window.scrollY};
  document.querySelectorAll("tr.diffrow").forEach(dr=>{
    const fr=dr.previousElementSibling;
    if(fr&&fr.classList.contains("filerow")&&fr.dataset.path)st.paths.push(fr.dataset.path);
  });
  return st;
}
async function restoreState(st){
  for(const p of st.paths){
    const tr=document.querySelector('tr.filerow[data-path="'+CSS.escape(p)+'"]');
    if(tr&&filesByPath[p])await toggleRow(tr,filesByPath[p],postDiffCurrent,tableRoot);
  }
  window.scrollTo(0,st.y);
}

// --- reviewed marks (#2): localStorage per repo+path, auto-reset via sig
function reviewedKey(){return "wvdiff:reviewed:"+(repoPath||"?");}
function getReviewed(){try{return JSON.parse(localStorage.getItem(reviewedKey())||"{}");}catch(e){return {};}}
function setReviewed(path,sig){
  const m=getReviewed();m[path]=sig;
  try{localStorage.setItem(reviewedKey(),JSON.stringify(m));}catch(e){/* private mode */}
}
function clearReviewed(path){
  const m=getReviewed();delete m[path];
  try{localStorage.setItem(reviewedKey(),JSON.stringify(m));}catch(e){/* private mode */}
}
function isReviewed(f){return !!(f&&f.sig&&getReviewed()[f.path]===f.sig);}
function reviewedCount(files){return files.filter(isReviewed).length;}

// --- shared filter model (#7 reviewed filter + path filter, #16 log filter)
const filterState={q:"",unreviewedOnly:false};
function applyFilter(){
  let shown=0;
  document.querySelectorAll("tr.filerow").forEach(tr=>{
    const f=filesByPath[tr.dataset.path];
    if(!f)return;
    const okQ=!filterState.q||f.path.toLowerCase().includes(filterState.q.toLowerCase());
    const okR=!filterState.unreviewedOnly||!isReviewed(f);
    const vis=okQ&&okR;
    tr.style.display=vis?"":"none";
    if(vis)shown++;
    const dr=tr.nextElementSibling;
    if(dr&&dr.classList.contains("diffrow"))dr.style.display=vis?"":"none";
  });
  const tot=document.querySelector("tr.totalrow");
  if(tot)tot.style.display=shown===Object.keys(filesByPath).length?"":"none";
}
let logFilterState="";
function applyLogFilter(){
  const q=logFilterState.toLowerCase();
  let shown=0;
  document.querySelectorAll(".logrow").forEach(r=>{
    const hit=!q||r.textContent.toLowerCase().includes(q);
    r.style.display=hit?"":"none";
    if(hit)shown++;
  });
  const lc=$("#logCount");
  if(lc)lc.textContent=shown+" shown";
}

function updateReviewHeader(files){
  const el=$("#reviewedInfo");
  if(!el)return;
  if(!files||!files.length){el.textContent="";return;}
  el.textContent=reviewedCount(files)+"/"+files.length+" reviewed";
}
function setupRvwFilterToggle(){
  const btn=$("#rvwFilter");
  btn.classList.toggle("active",filterState.unreviewedOnly);
  btn.addEventListener("click",()=>{
    filterState.unreviewedOnly=!filterState.unreviewedOnly;
    btn.classList.toggle("active",filterState.unreviewedOnly);
    applyFilter();
  });
}

// --- keyboard navigation (#6)
function visibleFileRows(){return [...document.querySelectorAll("tr.filerow")].filter(tr=>tr.style.display!=="none");}
function selectedRow(){return document.querySelector("tr.filerow.selected");}
function selectRow(tr,scroll=true){
  document.querySelectorAll("tr.filerow.selected").forEach(r=>r.classList.remove("selected"));
  if(tr){tr.classList.add("selected");if(scroll)tr.scrollIntoView({block:"nearest"});}
}
function moveSelection(delta){
  const rows=visibleFileRows();
  if(!rows.length)return;
  let i=rows.indexOf(selectedRow());
  if(i<0)i=0;else i=Math.min(rows.length-1,Math.max(0,i+delta));
  selectRow(rows[i]);
}
function setupKeys(){
  document.addEventListener("keydown",e=>{
    if(e.target.tagName==="INPUT"||e.target.tagName==="TEXTAREA")return;
    const k=e.key;
    if(k==="j"||k==="n"){moveSelection(1);e.preventDefault();}
    else if(k==="k"||k==="p"){moveSelection(-1);e.preventDefault();}
    else if(k==="Enter"){const tr=selectedRow();if(tr)tr.click();e.preventDefault();}
    else if(k==="/"){const f=$("#pathFilter");if(f){f.focus();e.preventDefault();}}
    else if(k==="Escape"){
      const f=$("#pathFilter");
      if(f){f.value="";filterState.q="";applyFilter();f.blur();}
      e.preventDefault();
    }
    else if(k==="?"){toggleKbdHelp();e.preventDefault();}
  });
}
function toggleKbdHelp(){
  let el=$("#kbd-help");
  if(!el){
    el=document.createElement("pre");el.id="kbd-help";el.className="kbdhelp";
    el.textContent="j / n  next file\nk / p  prev file\nEnter  toggle diff\n/      filter paths\nEsc    clear filter\n?      toggle this help";
    document.body.appendChild(el);
  }
  el.style.display=el.style.display==="block"?"none":"block";
}


function stopPoll(){if(pollTimer){clearInterval(pollTimer);pollTimer=null;}lastRev=null;}
function api(p){return fetch(p).then(r=>{if(!r.ok)throw new Error(p+" "+r.status);return r.json();});}

function badge(s){return `<span class="badge ${esc(s)}">${esc(s)}</span>`;}
function pathCell(f){
  const arrow=`<span class="arrow">&rarr;</span>`;
  const fmt=p=>{const i=p.lastIndexOf("/");return i<0?`<span class="base">${esc(p)}</span>`
    :`<span class="dir">${esc(p.slice(0,i+1))}</span><span class="base">${esc(p.slice(i+1))}</span>`;};
  return `<span class="path">${f.oldPath?fmt(f.oldPath)+arrow+fmt(f.path):fmt(f.path)}</span>`;
}
function bar(f,max){
  const w=n=>Math.round(n/max*100);
  return `<span class="bar"><span class="a" style="width:${w(f.add)}px"></span><span class="d" style="width:${w(f.del)}px"></span></span>`;
}
function deltaCell(f){
  if(f.binary)return `<span class="delta"><span class="binarymark">binary</span></span>`;
  return `<span class="delta"><span class="minus">&minus;${f.del}</span> <span class="plus">+${f.add}</span></span>`;
}

function fileTable(files,totals,postDiff,withActions){
  const div=document.createElement("div");
  if(!files.length){div.className="empty";div.textContent="no changes";return div;}
  const max=Math.max(1,...files.map(f=>f.add+f.del));
  let rows=files.map((f,i)=>{
    const chk=`<input type="checkbox" class="rvw"${isReviewed(f)?" checked":""}>`;
    let acts="";
    if(withActions&&f.xy){
      const btn=(op,label,danger)=>`<button class="actbtn${danger?" danger":""}" data-op="${op}">${label}</button>`;
      if(f.untracked||f.xy[0]===" "||f.xy[0]==="?")acts=btn("stage","stage")+btn("discard","discard",true);
      else if(f.xy[0]==="M"||f.xy[0]==="A")acts=btn("unstage","unstage")+btn("discard","discard",true);
      else acts=btn("stage","stage")+btn("discard","discard",true);
    }
    return `
   <tr class="filerow" data-i="${i}" data-path="${esc(f.path)}"><td class="chk">${chk}</td><td>${badge(f.status)}</td><td>${pathCell(f)}</td>
   <td>${bar(f,max)}</td><td style="text-align:right">${deltaCell(f)}</td><td class="actcell">${acts}</td></tr>`;}).join("");
  const t=`<table class="files"><thead><tr><th class="chk"></th><th></th><th>Path</th><th>Size</th>
   <th style="text-align:right">Delta</th><th class="actcell"></th></tr></thead><tbody>${rows}
   <tr class="totalrow"><td class="chk"></td><td></td><td>${files.length} file${files.length>1?"s":""}</td><td></td>
   <td style="text-align:right"><span class="delta"><span class="minus">&minus;${totals.del}</span> <span class="plus">+${totals.add}</span></span></td><td></td></tr>
   </tbody></table>`;
  div.innerHTML=t;
  div.querySelectorAll("tr.filerow").forEach(tr=>{
    const f=files[+tr.dataset.i];
    tr.addEventListener("click",()=>toggleRow(tr,f,postDiff,div));
    const cb=tr.querySelector("input.rvw");
    if(cb)cb.addEventListener("change",()=>{
      if(cb.checked)setReviewed(f.path,f.sig);else clearReviewed(f.path);
      updateReviewHeader(files);
    });
    tr.querySelectorAll("button.actbtn").forEach(b=>{
      b.addEventListener("click",async e=>{
        e.stopPropagation();
        const op=b.dataset.op;
        if(op==="discard"&&!window.confirm("Discard changes in "+f.path+"?"))return;
        b.disabled=true;
        try{
          const r=await fetch("/api/action",{method:"POST",
            headers:{"Content-Type":"application/json"},
            body:JSON.stringify({op,path:f.path})});
          if(!r.ok)throw new Error(await r.text());
        }catch(err){window.alert("action failed: "+err.message);b.disabled=false;return;}
        await renderWorktree();
      });
    });
  });
  return div;
}

async function toggleRow(tr,f,postDiff,root){
  const next=tr.nextElementSibling;
  if(next&&next.classList.contains("diffrow")){next.remove();return;}
  root.querySelectorAll("tr.diffrow").forEach(r=>r.remove());
  const dtr=document.createElement("tr");
  dtr.className="diffrow";
  const td=document.createElement("td");
  td.colSpan=6;td.className="diffcell";
  const box=document.createElement("div");box.className="diffbox";
  td.appendChild(box);dtr.appendChild(td);
  tr.after(dtr);
  box.textContent="loading diff…";
  let text;
  if(f.binary){text="Binary file not shown.";}
  else{
    try{text=await postDiff(f);}
    catch(e){text="error: "+e.message;}
  }
  renderDiffBox(box,text);
}

function renderDiffBox(box,text){
  box.textContent="";
  box.dataset.diffText=text;
  if(text==="Binary file not shown."||text.startsWith("error:")){
    const pre=document.createElement("pre");pre.style.cssText="margin:8px;color:var(--muted)";
    pre.textContent=text;box.appendChild(pre);return;
  }
  if(!text.trim()){box.textContent="(no textual diff)";return;}
  try{new Diff2HtmlUI(box,text,D2H_CFG).draw();}
  catch(e){box.textContent=text;}
}

function postWorktree(f){
  const paths=[f.path];if(f.oldPath)paths.push(f.oldPath);
  return fetch("/api/diff/worktree",{method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({paths,untracked:!!f.untracked,w:wsOn()})}).then(async r=>{
    if(!r.ok)throw new Error(await r.text());return r.text();});
}
function postCommit(sha){return f=>{
  const paths=[f.path];if(f.oldPath)paths.push(f.oldPath);
  return fetch("/api/diff/commit",{method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({sha,paths,w:wsOn()})}).then(async r=>{
    if(!r.ok)throw new Error(await r.text());return r.text();});
};}
function postVsup(f){
  const paths=[f.path];if(f.oldPath)paths.push(f.oldPath);
  return fetch("/api/diff/vsup",{method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({paths,w:wsOn()})}).then(async r=>{
    if(!r.ok)throw new Error(await r.text());return r.text();});
}

function tabs(active){
  $("#tabs").innerHTML=
   `<button data-p="/" class="${active==="work"?"active":""}">Working tree</button>
    <button data-p="/vsup" class="${active==="vsup"?"active":""}">vs upstream</button>
    <button data-p="/log" class="${active==="log"?"active":""}">Log</button>`;
  $("#tabs").querySelectorAll("button").forEach(b=>b.addEventListener("click",()=>nav(b.dataset.p)));
}

let capturedState=null;
async function renderWorktree(){
  tabs("work");
  const m=$("#main");m.innerHTML='<div class="empty">loading…</div>';
  const d=await api("/api/worktree");
  repoPath=d.repoPath||repoPath;
  $("#repoName").textContent=d.repo||"";
  $("#branch").textContent=d.branch?"("+d.branch+")":"";
  $("#hdrTotals").textContent=d.totals?`+${d.totals.add} \u2212${d.totals.del}`:"";
  const tbl=fileTable(d.files,d.totals,postWorktree,true);
  m.innerHTML="";
  m.appendChild(makeFilterRow());
  m.appendChild(tbl);
  m.appendChild(makeCommitBox());
  tableRoot=tbl;filesByPath={};d.files.forEach(f=>filesByPath[f.path]=f);
  postDiffCurrent=postWorktree;
  updateReviewHeader(d.files);
  lastRev=d.rev;
  applyFilter();
  if(d.files.length===1)autoExpand(d.files[0].path);  // single-file auto-expand (#5)
}
function makeFilterRow(){
  const div=document.createElement("div");div.className="filterrow";
  div.innerHTML=`<input id="pathFilter" class="filter" placeholder="filter paths…">`;
  const inp=div.querySelector("#pathFilter");
  inp.value=filterState.q;
  inp.addEventListener("input",()=>{filterState.q=inp.value;applyFilter();});
  return div;
}
async function renderLog(){
  tabs("log");
  const m=$("#main");m.innerHTML='<div class="empty">loading…</div>';
  const d=await api("/api/log");
  $("#branch").textContent="";$("#hdrTotals").textContent="";$("#reviewedInfo").textContent="";
  m.innerHTML="";
  if(!d.commits.length){m.innerHTML='<div class="empty">no commits</div>';return;}
  const fdiv=document.createElement("div");fdiv.className="filterrow";
  fdiv.innerHTML=`<input id="logFilter" class="filter" placeholder="filter log…"><span class="logcount" id="logCount"></span>`;
  const linp=fdiv.querySelector("#logFilter");
  linp.value=logFilterState;
  linp.addEventListener("input",()=>{logFilterState=linp.value;applyLogFilter();});
  m.appendChild(fdiv);
  const wrap=document.createElement("div");
  wrap.innerHTML=d.commits.map(c=>`<div class="logrow" data-sha="${esc(c.sha)}">
   <span class="sha">${esc(c.short)}</span><span class="subj">${esc(c.subject)}</span>
   <span class="by">${esc(c.author)}</span><span class="dt">${new Date(c.timestamp*1000).toISOString().slice(0,10)}</span></div>`).join("");
  wrap.querySelectorAll(".logrow").forEach(r=>r.addEventListener("click",()=>nav("/commit/"+r.dataset.sha)));
  m.appendChild(wrap);
  applyLogFilter();
}
async function renderVsup(){
  tabs("vsup");
  const m=$("#main");m.innerHTML='<div class="empty">loading…</div>';
  const d=await api("/api/vsup");
  $("#branch").textContent="";$("#hdrTotals").textContent="";$("#reviewedInfo").textContent="";
  m.innerHTML="";
  if(d.upstream===null){m.innerHTML='<div class="empty">no upstream branch</div>';return;}
  const hdr=document.createElement("div");hdr.className="commitbox";
  hdr.innerHTML=`<div class="meta">${d.ahead} commit${d.ahead===1?"":"s"} ahead of <span class="sha">${esc(d.upstream)}</span></div>`;
  m.appendChild(hdr);
  const tbl=fileTable(d.files,d.totals,postVsup,false);
  m.appendChild(tbl);
  tableRoot=tbl;filesByPath={};d.files.forEach(f=>filesByPath[f.path]=f);
  postDiffCurrent=postVsup;
}
async function renderCommit(sha){
  const m=$("#main");m.innerHTML='<div class="empty">loading…</div>';
  let d;try{d=await api("/api/commit/"+sha);}catch(e){m.innerHTML=`<div class="err">${esc(e.message)}</div>`;return;}
  tabs("commit");
  $("#tabs").innerHTML=`<button data-p="/log">&larr; Log</button>
   <button disabled style="color:var(--orange);cursor:default">${esc(d.short)}</button>`;
  $("#tabs").querySelector("button").addEventListener("click",()=>nav("/log"));
  $("#branch").textContent="";$("#hdrTotals").textContent="";$("#reviewedInfo").textContent="";
  m.innerHTML=`<div class="commitbox"><div class="subj">${esc(d.subject)}</div>
   ${d.body?`<div class="body">${esc(d.body)}</div>`:""}
   <div class="meta"><span class="sha">${esc(d.short)}</span> &middot; ${esc(d.author)}
   &middot; ${esc(d.date)}${d.parents.length?" &middot; parent"+(d.parents.length>1?"s":"")+": "+d.parents.map(p=>`<span class="sha">${esc(p)}</span>`).join(" "):""}</div></div>`;
  const tbl=fileTable(d.files,d.totals,postCommit(d.sha),false);
  m.appendChild(tbl);
  tableRoot=tbl;filesByPath={};d.files.forEach(f=>filesByPath[f.path]=f);
  postDiffCurrent=postCommit(d.sha);
}

// --- commit box (#13): staged changes only, then jump to the new commit
function makeCommitBox(){
  const div=document.createElement("div");div.className="commitbox";
  div.innerHTML=`<textarea id="commitMsg" rows="3" placeholder="commit message (staged changes)"></textarea>
   <div class="commitrow"><button id="commitBtn" class="viewtoggle">Commit</button><span class="errtxt" id="commitErr"></span></div>`;
  const btn=div.querySelector("#commitBtn");
  btn.addEventListener("click",async()=>{
    const msg=div.querySelector("#commitMsg").value;
    const err=div.querySelector("#commitErr");err.textContent="";
    try{
      const r=await fetch("/api/commit",{method:"POST",
        headers:{"Content-Type":"application/json"},body:JSON.stringify({message:msg})});
      if(!r.ok)throw new Error(await r.text());
      const d=await r.json();
      nav("/commit/"+d.sha);
    }catch(e){err.textContent=e.message;}
  });
  return div;
}

function nav(p){history.pushState(null,"",p);route();}
async function route(){
  stopPoll();
  const p=location.pathname;
  const expand=new URLSearchParams(location.search).get("expand");
  try{
    if(p==="/"){
      capturedState=null;
      await renderWorktree();
      if(expand)autoExpand(expand);
      pollTimer=setInterval(async()=>{
        try{
          const c=await api("/api/worktree?cheap=1");
          if(c.rev!==lastRev){
            if(document.hidden){
              fetch("/api/notify",{method:"POST",
                headers:{"Content-Type":"application/json"},body:"{}"}).catch(()=>{});
            }
            capturedState=captureState();
            await renderWorktree();
            await restoreState(capturedState);
          }
        }catch(e){/* server may be restarting */}
      },2000);
    }else if(p==="/log"){await renderLog();}
    else if(p==="/vsup"){await renderVsup();}
    else{const m=p.match(/^\/commit\/([0-9a-f]{7,40})$/i);
      if(m){await renderCommit(m[1]);if(expand)autoExpand(expand);}
      else await renderLog();}
  }catch(e){$("#main").innerHTML=`<div class="err">${esc(e.message)}</div>`;}
}
function autoExpand(path){
  const rows=[...document.querySelectorAll("tr.filerow")];
  for(const tr of rows){
    if(tr.dataset.path===path){tr.click();return;}
    if(tr.cells[2]&&tr.cells[2].textContent.includes(path)){tr.click();return;}
  }
}
window.addEventListener("popstate",route);
document.addEventListener("visibilitychange",()=>{
  if(!document.hidden)fetch("/api/notify",{method:"POST",
    headers:{"Content-Type":"application/json"},body:'{"clear":true}'}).catch(()=>{});
});
setupViewToggle();
setupWsToggle();
