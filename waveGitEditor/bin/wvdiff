class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "wvdiff/1.0"

    def log_message(self, fmt, *args):
        pass  # per-request noise goes nowhere; errors still go to wvdiff.log

    def _touch(self):
        global LAST_REQUEST
        LAST_REQUEST = time.time()

    def _send(self, code, body, ctype):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _json(self, obj, code=200):
        self._send(code, json.dumps(obj), "application/json")

    def _error(self, code, msg):
        self._send(code, msg, "text/plain")

    def _asset(self, name):
        path = os.path.join(ASSETS_DIR, os.path.basename(name))
        if not os.path.isfile(path):
            return self._error(404, "not found")
        ctype = "text/css" if name.endswith(".css") else "text/javascript"
        with open(path, "rb") as f:
            self._send(200, f.read(), ctype)

    def do_GET(self):
        self._touch()
        path = urlparse(self.path).path
        try:
            if path == "/healthz":
                self._json({"repo": REPO, "pid": os.getpid(), "code_mtime": CODE_MTIME})
            elif path.startswith("/assets/"):
                self._asset(unquote(path[len("/assets/"):]))
            elif path in ("/", "/log", "/vsup") or re.match(r"^/commit/[0-9a-fA-F]{7,40}$", path):
                self._send(200, PAGE, "text/html")
            elif path == "/api/worktree":
                qs = urlparse(self.path).query
                if "cheap=1" in qs.split("&"):
                    rev, _ = worktree_rev()
                    return self._json({"rev": rev})
                d = worktree_files()
                d["repo"] = os.path.basename(REPO)
                self._json(d)
            elif path == "/api/log":
                out = git("log", "-n", "300", "--format=%H%x1f%h%x1f%an%x1f%at%x1f%s")
                commits = []
                for line in out.split("\n"):
                    if not line:
                        continue
                    sha, short, an, at, subj = line.split("\x1f", 4)
                    commits.append({"sha": sha, "short": short, "author": an,
                                    "timestamp": int(at), "subject": subj})
                self._json({"commits": commits})
            elif path.startswith("/api/commit/"):
                sha = unquote(path[len("/api/commit/"):])
                if not re.match(r"^[0-9a-fA-F]{7,40}$", sha):
                    return self._error(400, "bad sha")
                self._json(commit_data(sha))
            elif path == "/api/vsup":
                self._json(vsup_data())
            else:
                self._error(404, "not found")
        except RuntimeError as e:
            self._error(500, str(e))
        except Exception as e:  # noqa: BLE001
            log("GET %s error: %r" % (path, e))
            self._error(500, "internal error")

    def _read_json(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n <= 0 or n > 1 << 20:
            raise ValueError("bad body size")
        return json.loads(self.rfile.read(n).decode("utf-8"))

    def do_POST(self):
        self._touch()
        path = urlparse(self.path).path
        try:
            body = self._read_json()
            if path == "/api/diff/worktree":
                paths = body.get("paths") or []
                if not isinstance(paths, list) or not all(isinstance(p, str) for p in paths):
                    return self._error(400, "bad paths")
                self._send(200, diff_worktree(paths, bool(body.get("w"))), "text/plain")
            elif path == "/api/diff/commit":
                sha = body.get("sha") or ""
                paths = body.get("paths") or []
                if not re.match(r"^[0-9a-fA-F]{7,40}$", sha):
                    return self._error(400, "bad sha")
                if not isinstance(paths, list) or not all(isinstance(p, str) for p in paths):
                    return self._error(400, "bad paths")
                self._send(200, diff_commit(sha, paths, bool(body.get("w"))), "text/plain")
            elif path == "/api/diff/vsup":
                paths = body.get("paths") or []
                if not isinstance(paths, list) or not all(isinstance(p, str) for p in paths):
                    return self._error(400, "bad paths")
                self._send(200, diff_vsup(paths, bool(body.get("w"))), "text/plain")
            elif path == "/api/action":
                op = body.get("op")
                p = body.get("path")
                if op not in ("stage", "unstage", "discard"):
                    return self._error(400, "bad op: %r" % (op,))
                if not isinstance(p, str) or not p:
                    return self._error(400, "bad path")
                self._json(act(p, op))
            elif path == "/api/commit":
                message = body.get("message")
                if not isinstance(message, str):
                    return self._error(400, "bad message")
                self._json(commit_staged(message))
            elif path == "/api/notify":
                self._json(notify_badge(bool(body.get("clear"))))
            else:
                self._error(404, "not found")
        except (ValueError, json.JSONDecodeError) as e:
            self._error(400, str(e))
        except RuntimeError as e:
            self._error(500, str(e))
        except Exception as e:  # noqa: BLE001
            log("POST %s error: %r" % (path, e))
            self._error(500, "internal error")


def main():
    global REPO, PORT_FILE
    import argparse
    ap = argparse.ArgumentParser(description="wvdiff server")
    ap.add_argument("--repo", required=True)
    ap.add_argument("--port", type=int, default=0)
    args = ap.parse_args()
    REPO = os.path.abspath(args.repo)
    if not os.path.isdir(os.path.join(REPO, ".git")):
        sys.stderr.write("wvdiff: not a git repo: %s\n" % REPO)
        return 1
    key = hashlib.md5(REPO.encode()).hexdigest()
    PORT_FILE = os.path.join(STATE_DIR, key + ".port")

    # single instance per repo: non-blocking lock on <key>.lock, held open
    # for the process lifetime (auto-released on exit, even SIGKILL)
    lock_file = os.path.join(STATE_DIR, key + ".lock")
    import fcntl
    lock_fd = os.open(lock_file, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        # another wvdiff already owns this repo; wait briefly for its port
        # file (it may still be starting), then exit quietly
        for _ in range(30):
            if os.path.isfile(PORT_FILE):
                time.sleep(0.1)
                sys.stderr.write("wvdiff: another instance serves %s\n" % REPO)
                return 0
            time.sleep(0.1)
        sys.stderr.write("wvdiff: lock busy for %s but no port file\n" % REPO)
        return 0

    srv = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    port = srv.server_address[1]
    with open(PORT_FILE, "w") as f:
        f.write("%d\n" % port)
    log("serving %s on 127.0.0.1:%d (idle %ds)" % (REPO, port, IDLE_SECS))

    def bye(signum, frame):
        try:
            os.unlink(PORT_FILE)
        except OSError:
            pass
        log("signal %d, exiting" % signum)
        os._exit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)

    def idle_watch():
        while True:
            time.sleep(2)
            if time.time() - LAST_REQUEST > IDLE_SECS:
                try:
                    os.unlink(PORT_FILE)
                except OSError:
                    pass
                log("idle timeout, exiting")
                os._exit(0)

    threading.Thread(target=idle_watch, daemon=True).start()
    srv.serve_forever()


if __name__ == "__main__":
    sys.exit(main())
